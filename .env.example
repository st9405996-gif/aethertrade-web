# Empty configuration template only. No fake credentials.
# Connect your own project through Settings → General → External Supabase.
#
# BUILD-TIME public configuration (embedded in the browser bundle; not secrets):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile SITE key (public). Required for live submissions: without it the form
# cannot obtain a challenge token and live submissions fail closed.
VITE_TURNSTILE_SITE_KEY=
# Admin demo is compiled out of production builds. Set in the BUILD environment ONLY when a
# deliberate decision has been made. A .env file is not used for this flag.
VITE_ENABLE_ADMIN_DEMO=

# SERVER-ONLY values. Never prefix a secret with VITE_. Store as Worker secrets in production.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Live inquiry delivery. OFF unless INQUIRY_DELIVERY_ENABLED is "true" AND every value below
# is present and valid. A valid configuration is not proof of delivery; run the staging runbook.
INQUIRY_DELIVERY_ENABLED=
# Internal recipient for general inquiries. Confirm the mailbox is monitored before enabling.
INQUIRY_NOTIFY_TO=
# Internal recipient for demo requests and Sales-category inquiries.
INQUIRY_SALES_NOTIFY_TO=
# Verified sender: "address@verified-domain" or "AETHER-TRADE <address@verified-domain>".
INQUIRY_FROM_EMAIL=
RESEND_API_KEY=
# Signs confirmation tokens (min 32 characters). Generate a random value per environment.
CONFIRMATION_SECRET=
# Cloudflare Turnstile SECRET key (server-only).
TURNSTILE_SECRET_KEY=
# Hostname the Turnstile widget is served on, e.g. aethertrade.cloud (no scheme, no path).
PUBLIC_SITE_HOSTNAME=
# Keys the salted hash of client addresses used for rate limiting (min 32 characters).
ABUSE_HASH_SECRET=
# Bearer token for GET /api/inquiry-health (min 32 characters). Unset = endpoint hidden.
OPS_HEALTH_TOKEN=

# Reserved for a future abuse-challenge provider. Not read by any code.
CHALLENGE_SECRET_KEY=
